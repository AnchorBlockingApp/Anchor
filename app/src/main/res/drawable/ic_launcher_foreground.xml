<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!--
      Anchor with a crown where the ring would normally sit. The shank and
      crossbar already read as a cross; the crown is filled rather than stroked
      because fine strokes disappear at launcher size.
    -->

    <!-- crown -->
    <path android:fillColor="#C9A227"
        android:pathData="M45,35 L45,27 L49.5,31 L54,25.5 L58.5,31 L63,27 L63,35 Z" />
    <path android:fillColor="#C9A227"
        android:pathData="M45,25.4 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0" />
    <path android:fillColor="#C9A227"
        android:pathData="M54,23.6 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0" />
    <path android:fillColor="#C9A227"
        android:pathData="M63,25.4 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0" />

    <!-- shank -->
    <path android:strokeColor="#C9A227" android:strokeWidth="3.4"
        android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M54,35 L54,74" />

    <!-- crossbar -->
    <path android:strokeColor="#C9A227" android:strokeWidth="3.4"
        android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M42,45 L66,45" />

    <!-- flukes -->
    <path android:strokeColor="#C9A227" android:strokeWidth="3.4"
        android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M36,62 C36,74 44,79 54,79 C64,79 72,74 72,62" />
</vector>
